# Copy to .env.local and fill in, or run `neon env pull` to have Neon write the values.
# Never commit the real file.

# Postgres — your database connection
DATABASE_URL=""
DATABASE_URL_POOLED=""

# Neon Managed Better Auth — sign-in for your app
NEON_AUTH_BASE_URL=""

# Storage — S3-compatible object storage
AWS_ENDPOINT_URL_S3=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION=""
S3_BUCKET="uploads"

# Optional
# PORT=4000
# The API's own public origin. Neon Auth must trust it: `neon neon-auth domain add <origin>`.
# Defaults to http://localhost:<PORT>, which Neon Auth trusts out of the box.
# AUTH_ORIGIN="https://api.example.com"
# The gym's time zone. Class times in the timetable are in this zone. Default: Asia/Kolkata
# GYM_TIME_ZONE="Asia/Kolkata"
# Set to 1 when the API runs behind one proxy / load balancer (most hosts), so login rate
# limits see each member's real address.
# TRUST_PROXY=1
