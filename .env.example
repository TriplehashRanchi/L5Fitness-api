# Copy to .env.local and fill in, or run `neon env pull` to have Neon write the values.
# Never commit the real file.

# Postgres — your database connection
DATABASE_URL=""
DATABASE_URL_POOLED=""

# Firebase Authentication: the project ID is all the server needs to check a member's token
FIREBASE_PROJECT_ID=""
# Public web key. Only needed to run `npm run test:e2e`
# FIREBASE_WEB_API_KEY=""

# Storage — S3-compatible object storage
AWS_ENDPOINT_URL_S3=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION=""
S3_BUCKET="uploads"

# Optional
# PORT=4000
# The gym's time zone. Class times in the timetable are in this zone. Default: Asia/Kolkata
# GYM_TIME_ZONE="Asia/Kolkata"
# Set to 1 when the API runs behind one proxy / load balancer (most hosts), so login rate
# limits see each member's real address.
# TRUST_PROXY=1

# Console admin: the ONE admin signs in to the web console with this email and password.
# Change them here and restart the API. Use a long password (12+ characters) once the console is online:
# with NODE_ENV=production a shorter password switches admin sign-in off.
# ADMIN_EMAIL="admin@example.com"
# ADMIN_PASSWORD=""
# Signs the admin's 12-hour login. Any long random text (32+ characters), kept secret.
# ADMIN_SESSION_SECRET=""
